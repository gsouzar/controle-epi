rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function autenticado() { return request.auth != null; }
  function perfil(valor) {
   return autenticado() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
    && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil == valor;
  }
  function tecnico() { return perfil('tecnico'); }
  function colaborador() { return perfil('colaborador'); }
  function texto(valor, limite) { return valor is string && valor.size() > 0 && valor.size() <= limite && valor.matches('.*[^ \\t\\r\\n].*'); }
  function contaColaborador(uid) {
   return uid is string && exists(/databases/$(database)/documents/usuarios/$(uid))
    && get(/databases/$(database)/documents/usuarios/$(uid)).data.perfil == 'colaborador';
  }
  match /usuarios/{uid} {
   allow get: if autenticado() && (request.auth.uid == uid || (tecnico() && resource.data.perfil == 'colaborador'));
   allow list, create, update, delete: if false;
  }
  match /epis/{id} {
   allow read: if tecnico();
   allow create: if tecnico()
    && request.resource.data.keys().hasAll(['descricao','ca','validadeCa'])
    && request.resource.data.keys().hasOnly(['descricao','ca','validadeCa'])
    && texto(request.resource.data.descricao,120)
    && request.resource.data.ca is string && request.resource.data.ca.matches('^[0-9]{1,20}$')
    && request.resource.data.validadeCa is timestamp;
   allow update, delete: if false;
  }
  match /colaboradores/{uid} {
   allow read: if tecnico() || (colaborador() && request.auth.uid == uid);
   allow create: if tecnico() && contaColaborador(uid)
    && request.resource.data.keys().hasAll(['nome','matricula','setor'])
    && request.resource.data.keys().hasOnly(['nome','matricula','setor'])
    && texto(request.resource.data.nome,120) && texto(request.resource.data.matricula,30)
    && texto(request.resource.data.setor,80);
   allow update, delete: if false;
  }
  function estoquePath(epiId) {
   return /databases/$(database)/documents/estoques/$(epiId);
  }
  function reposicaoPath(epiId, id) {
   return /databases/$(database)/documents/estoques/$(epiId)/reposicoes/$(id);
  }
  function entregaPath(id) {
   return /databases/$(database)/documents/entregas/$(id);
  }
  function saldoAntes(path) {
   return exists(path) ? get(path).data.saldo : 0;
  }
  function estoqueValido(novo) {
   return novo.keys().hasAll(['saldo','ultimaOperacao','origem'])
    && novo.keys().hasOnly(['saldo','ultimaOperacao','origem'])
    && novo.saldo is int && novo.saldo >= 0 && novo.saldo <= 1000000000
    && novo.ultimaOperacao is string && novo.ultimaOperacao.matches('^[A-Za-z0-9_-]{1,128}$');
  }
  function reposicaoValida(epiId, novo, anterior) {
   let path = reposicaoPath(epiId, novo.ultimaOperacao);
   return novo.origem == 'reposicao' && !exists(path) && existsAfter(path)
    && getAfter(path).data.quantidade == novo.saldo - anterior;
  }
  function baixaValida(epiId, novo, anterior) {
   let path = entregaPath(novo.ultimaOperacao);
   return novo.origem == 'entrega' && !exists(path) && existsAfter(path)
    && getAfter(path).data.epiId == epiId
    && getAfter(path).data.quantidade == anterior - novo.saldo;
  }
  function entregaAtualizaEstoque(epiId, id, quantidade) {
   let path = estoquePath(epiId);
   return !exists(path)
    ? !existsAfter(path)
    : existsAfter(path) && getAfter(path).data.ultimaOperacao == id
     && getAfter(path).data.origem == 'entrega'
     && getAfter(path).data.saldo == get(path).data.saldo - quantidade;
  }
  match /estoques/{epiId} {
   allow read: if tecnico();
   allow create: if tecnico() && exists(/databases/$(database)/documents/epis/$(epiId))
    && estoqueValido(request.resource.data) && reposicaoValida(epiId, request.resource.data, 0);
   allow update: if tecnico() && estoqueValido(request.resource.data)
    && (reposicaoValida(epiId, request.resource.data, resource.data.saldo)
        || baixaValida(epiId, request.resource.data, resource.data.saldo));
   allow delete: if false;
   match /reposicoes/{id} {
    allow get: if tecnico();
    allow create: if tecnico() && request.resource.data.keys().hasOnly(['quantidade'])
     && request.resource.data.quantidade is int
     && request.resource.data.quantidade >= (exists(estoquePath(epiId)) ? 1 : 0)
     && existsAfter(estoquePath(epiId))
     && getAfter(estoquePath(epiId)).data.origem == 'reposicao'
     && getAfter(estoquePath(epiId)).data.ultimaOperacao == id
     && getAfter(estoquePath(epiId)).data.saldo == saldoAntes(estoquePath(epiId)) + request.resource.data.quantidade;
    allow list, update, delete: if false;
   }
  }
  match /entregas/{id} {
   allow read: if tecnico() || (colaborador() && resource.data.colaboradorUid == request.auth.uid);
   allow create: if tecnico()
    && request.resource.data.keys().hasAll(['colaboradorUid','epiId','epiDescricao','epiCa','quantidade','data','confirmado'])
    && request.resource.data.keys().hasOnly(['colaboradorUid','epiId','epiDescricao','epiCa','quantidade','data','confirmado','motivoTroca'])
    && request.resource.data.get('motivoTroca','') in ['', 'Desgaste', 'Perda', 'Tamanho errado']
    && texto(request.resource.data.colaboradorUid,128) && texto(request.resource.data.epiId,128)
    && contaColaborador(request.resource.data.colaboradorUid)
    && exists(/databases/$(database)/documents/colaboradores/$(request.resource.data.colaboradorUid))
    && exists(/databases/$(database)/documents/epis/$(request.resource.data.epiId))
    && request.resource.data.epiDescricao == get(/databases/$(database)/documents/epis/$(request.resource.data.epiId)).data.descricao
    && request.resource.data.epiCa == get(/databases/$(database)/documents/epis/$(request.resource.data.epiId)).data.ca
    && request.resource.data.quantidade is int && request.resource.data.quantidade >= 1 && request.resource.data.quantidade <= 9999
    && request.resource.data.data is timestamp && request.resource.data.confirmado == false
    && entregaAtualizaEstoque(request.resource.data.epiId, id, request.resource.data.quantidade);
   allow update: if colaborador() && resource.data.colaboradorUid == request.auth.uid
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmado'])
    && request.resource.data.confirmado is bool && request.resource.data.confirmado == true;
   allow delete: if false;
  }
  match /{document=**} { allow read, write: if false; }
 }
}
